{
  "name": "@highflame/codeoid-memory",
  "version": "0.4.0",
  "description": "Verbatim, workspace-scoped memory for AI coding agents — an MCP server any harness can mount. Episodes stored whole (never summarized), recalled by hybrid vector + BM25 + recency + path-overlap ranking.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highflame-ai/codeoid.git",
    "directory": "packages/memory"
  },
  "bin": {
    "codeoid-memory": "./dist/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": ["src", "dist", "!src/**/*.test.ts", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --format esm --packages external",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "memory",
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agent",
    "rag"
  ],
  "dependencies": {
    "@highflame/codeoid-protocol": "^0.4.0",
    "@xenova/transformers": "^2.17.2",
    "zod": "^4.0.0"
  }
}
